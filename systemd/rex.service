[Unit]
Description=Rex — local AI assistant daemon
Documentation=https://github.com/sigil-xyz/rex
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/rex
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rex

# Pass through user session environment for PipeWire/audio access
PassEnvironment=XDG_RUNTIME_DIR PIPEWIRE_RUNTIME_DIR PULSE_RUNTIME_PATH DBUS_SESSION_BUS_ADDRESS

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t %h/.cache/huggingface %h/.local/share/rex %h/Desktop %h/Documents %h/Downloads %h/Pictures %h/Videos %h/Music %h/.config/rex

[Install]
WantedBy=graphical-session.target
